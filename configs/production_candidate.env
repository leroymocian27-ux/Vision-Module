# Historical legacy RTSP rollback profile.
# It is NOT the Post-Fall V2 P3 production candidate and must not be used as
# evidence that PFV2 target-camera validation is complete. Real delivery remains disabled.

VISION_SERVICE_RUNTIME_PROFILE=production_candidate
PIPELINE_MODE=legacy

DEFAULT_CAMERA_ID=camera_01
# Fill this outside source control or provide via process env.
DEFAULT_RTSP_URL=
MOCK_CAMERA_ENABLED=false
DEVICE_DISCOVERY_ENABLED=true
DEVICE_DISCOVERY_CANDIDATE_HOST_START=1
DEVICE_DISCOVERY_CANDIDATE_HOST_END=254
DEVICE_DISCOVERY_CONNECT_TIMEOUT_MS=400
DEVICE_DISCOVERY_SCAN_TIMEOUT_MS=8000
DEVICE_DISCOVERY_MAX_WORKERS=32
CAMERA_RTSP_USERNAME=admin
CAMERA_RTSP_PASSWORD=
CAMERA_RTSP_PORT=10554
CAMERA_RTSP_PATH=/tcp/av0_0

DETECTION_ENABLED=true
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE=0.35
YOLO_IMGSZ=512
YOLO_DEVICE=

FALL_DETECTOR_ENABLED=true
FALL_HINT_IN_DETECTION_SERVICE=true
FALL_HINT_WORKER_ENABLED=false
YOLO_FALL_MODEL_PATH=models/yolo_fall_hint_v2_plus_b012_best.pt
YOLO_FALL_CONFIDENCE=0.25
YOLO_FALL_IMGSZ=512

ENABLE_TRACKING=true
ENABLE_POSE=false
POSE_PROVIDER=disabled_placeholder
ENABLE_TEMPORAL=false
TEMPORAL_MODEL_PROVIDER=mock

MAIN_SYSTEM_ALERT_ENABLED=false
MAIN_SYSTEM_REPORT_DRY_RUN=true
MAIN_SYSTEM_BASE_URL=http://192.168.8.252:8000/api/v1
EVENT_PIPELINE_ENABLED=false
EVENT_DELIVERY_ENABLED=false
EVENT_DELIVERY_MODE=dry_run
EVENT_DELIVERY_POST_APPROVED=false
EVENT_VLM_ENABLED=false
EVENT_QWEN_KEYFRAME_ANALYSIS_ENABLED=false
QWEN_MEDIA_INPUT_ENABLED=false
QWEN_MEDIA_PRIVACY_APPROVED=false

ROBOT_ASSIST_SERVICE_ENABLED=false
ROBOT_ASSIST_ENABLED=false
ROBOT_ASSIST_MODE=mock
ROBOT_AUTO_DISPATCH_ENABLED=false
GO2_READ_ONLY_ENABLED=false
GO2_CONTROL_ENABLED=false
GO2_LOW_LEVEL_CONTROL_ENABLED=false
GO2_CONTROL_APPROVED=false

STREAM_STALE_THRESHOLD_MS=3000
STREAM_STALE_RECONNECT_AFTER_MS=6000
CAPTURE_BACKEND=opencv
OPENCV_CAPTURE_BUFFERSIZE=1
