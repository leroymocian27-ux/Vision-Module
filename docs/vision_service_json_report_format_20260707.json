  "integration_rules": {
    "popup_deduplication": "主系统或前端应使用 incident_id 去重。同一个 incident_id 只弹一次窗。",
    "popup_trigger": "当 fall_alert_poll_response.should_popup 为 true，或 fall_event_push_to_main_system.event_type 为 fall_confirmed 且 status 为 fallen_confirmed 时，应触发跌倒告警弹窗。",
    "risk_policy": "risk_level 为 critical 或 high 时建议弹出强告警；medium 可做弱提醒；low 不建议弹窗。",
    "snapshot_policy": "snapshot_url 可直接用于主系统前端展示；snapshot_path 仅服务端排查使用，不建议暴露给终端用户。",
    "time_policy": "timestamp 建议统一使用 ISO 8601，带时区。当前现场时区为 Asia/Shanghai。"
  }
}
