EVENT_QWEN_KEYFRAME_TIMEOUT_SECONDS=90
EVENT_QWEN_KEYFRAME_MAX_IMAGES=6
EVENT_QWEN_KEYFRAME_MAX_IMAGE_BYTES=5242880
EVENT_OUTBOX_BACKEND=memory
EVENT_OUTBOX_SQLITE_PATH=data/event_outbox.sqlite3
EVENT_RING_BUFFER_SECONDS=8
EVENT_RING_BUFFER_MAX_FRAMES=96
EVENT_RING_BUFFER_MAX_BYTES=134217728
EVENT_WORKER_LOCK_TTL_SECONDS=30
EVENT_INCIDENT_COOLDOWN_SECONDS=30
