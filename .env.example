APP_NAME=vision-service
LOG_LEVEL=INFO

# Default safe local profile: Binary-First Post-Fall V2.
# - post_fall_v2: EfficientNet binary + multi-frame aggregator owns final fall decisions.
# - legacy / async_v1 / fall_disabled: retained rollback and historical modes.
# This example keeps external delivery and main-system alerts disabled.
PIPELINE_MODE=post_fall_v2
AUTO_START_STREAM=false

