EVENT_KEYFRAME_SERVING_ENABLED=false
EVENT_DELIVERY_ENABLED=false
EVENT_DELIVERY_MODE=dry_run
EVENT_DELIVERY_BACKEND=memory
EVENT_DELIVERY_SQLITE_PATH=data/event_delivery_outbox.sqlite3
