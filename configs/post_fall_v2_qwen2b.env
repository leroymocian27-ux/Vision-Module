# Post-Fall V2 Qwen 2B experimental profile.
# Keep schema, image count, resolution, and fusion aligned with the 4B baseline.

VISION_SERVICE_RUNTIME_PROFILE=post_fall_v2_qwen2b
PIPELINE_MODE=post_fall_v2

DEFAULT_CAMERA_ID=camera_01
VIDEO_SOURCE_MODE=mjpeg
GO2_MJPEG_URL=http://192.168.8.254:8093/stream.mjpg
DEFAULT_RTSP_URL=
MOCK_CAMERA_ENABLED=false
DEVICE_DISCOVERY_ENABLED=false

ENABLE_POSE=false
POSE_PROVIDER=disabled_placeholder
ENABLE_BEHAVIOR=false
ENABLE_TEMPORAL=false
TEMPORAL_MODEL_PROVIDER=mock

MAIN_SYSTEM_ALERT_ENABLED=false
MAIN_SYSTEM_REPORT_DRY_RUN=true
EVENT_PIPELINE_ENABLED=false
EVENT_DELIVERY_ENABLED=false
EVENT_DELIVERY_MODE=dry_run
EVENT_DELIVERY_POST_APPROVED=false
EVENT_VLM_ENABLED=false
EVENT_QWEN_KEYFRAME_ANALYSIS_ENABLED=false
QWEN_MEDIA_INPUT_ENABLED=true
QWEN_MEDIA_PRIVACY_APPROVED=true

POST_FALL_V2_ENABLED=true
POST_FALL_V2_MODEL_PATH=models/post_fall_v2/efficientnet_b0/fall_candidate_efficientnet_b0.onnx
POST_FALL_V2_BINARY_MODEL_PATH=models/post_fall_v2/efficientnet_b0/fall_candidate_efficientnet_b0.onnx
POST_FALL_V2_BINARY_MODEL_SHA256=e9871cdb4687055fb5d934dd994c2ad883adac0c2acab375c240f8e005ee04cc
POST_FALL_V2_INPUT_POLICY=FULL_FRAME_TRAIN_MATCHED
POST_FALL_V2_INPUT_MODE=full_frame
POST_FALL_V2_SAMPLE_FPS=10
POST_FALL_V2_QUEUE_SIZE=1
FOLLOW_TARGET_ENABLED=false
FOLLOW_TARGET_UDP_HOST=0.0.0.0
FOLLOW_TARGET_UDP_PORT=8766
FOLLOW_TARGET_FRESH_MS=300
FOLLOW_TARGET_GRACE_MS=700
FOLLOW_TARGET_CAMERA_HFOV_DEG=90
FOLLOW_TARGET_CAMERA_YAW_OFFSET_DEG=0
FOLLOW_TARGET_ROI_WIDTH_RATIO=0.50
FOLLOW_TARGET_GRACE_ROI_WIDTH_RATIO=0.70
FOLLOW_TARGET_CALIBRATION_LOG_ENABLED=false
POST_FALL_V2_BINARY_THRESHOLD=0.3979087471961975
POST_FALL_V2_WINDOW_SIZE=8
POST_FALL_V2_MIN_POSITIVE_FRAMES=1
POST_FALL_V2_MIN_CONSECUTIVE_FRAMES=1
POST_FALL_V2_POST_FALL_ALERT_MIN_MS=10000
POST_FALL_V2_CANDIDATE_MIN_MS=0
POST_FALL_V2_RECOVERY_MIN_MS=1500
POST_FALL_V2_COOLDOWN_MS=3000
POST_FALL_V2_EVENT_BUFFER_SECONDS=1
POST_FALL_V2_VLM_ENABLED=true
POST_FALL_V2_VLM_TIMEOUT_SECONDS=8
POST_FALL_V2_QWEN_ENABLED=true
POST_FALL_V2_QWEN_PROVIDER=qwen_keyframe
POST_FALL_V2_QWEN_PROFILE=qwen2b_experiment_v1
POST_FALL_V2_QWEN_MODEL=qwen3.5:2b
POST_FALL_V2_QWEN_PROMPT_VERSION=compact_2b_v1
POST_FALL_V2_QWEN_SCHEMA_VERSION=compact_v1
POST_FALL_V2_QWEN_FUSION_VERSION=demo_fusion_v2
POST_FALL_V2_QWEN_BASE_URL=http://127.0.0.1:11434/api/chat
