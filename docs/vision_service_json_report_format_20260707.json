{
  "document_name": "Vision Service JSON 数据回报格式",
  "format_version": "2026-07-07.v1",
  "service": "vision_service",
  "description": "本文件定义 Vision Service 向主系统、前端或联调脚本回报数据时建议使用的 JSON 格式。重点覆盖连接状态、实时检测结果、跌倒告警推送、告警轮询、10 分钟监听统计和错误回报。",
  "current_network": {
    "camera_ip": "192.168.8.250",
    "vision_service_base_url": "http://192.168.8.249:8000",
    "main_system_base_url": "http://192.168.8.248:8000/api/v1",
    "default_camera_id": "camera_01",
    "default_device_mac": "CAMERA-192.168.8.250"
  },
  "transport": {
    "push_to_main_system": {
      "method": "POST",
      "url": "http://192.168.8.248:8000/api/v1/video-bridge/fall-events",
      "content_type": "application/json",
      "auth_header": "X-Vision-Service-Token",
      "purpose": "Vision Service 确认跌倒后主动向主系统推送告警事件，主系统据此产生跌倒告警弹窗。"
    },
    "latest_result_polling": {
      "method": "GET",
      "url": "http://192.168.8.249:8000/integration/results/{camera_id}/latest",
      "purpose": "主系统或前端按需拉取某个摄像头最新结构化视觉结果。"
    },
    "fall_alert_polling": {
      "method": "GET",
      "url": "http://192.168.8.249:8000/integration/fall-alerts/{camera_id}/poll?last_incident_id={last_incident_id}",
      "purpose": "前端轮询是否有新的跌倒弹窗告警。"
    },
    "connection_status": {
      "method": "GET",
      "url": "http://192.168.8.249:8000/integration/connection-status",
      "purpose": "检查 Vision Service、主系统和摄像头链路状态。"
    }
  },
  "field_dictionary": {
    "camera_id": "摄像头 ID，例如 camera_01。",
    "stream_name": "视频流名称，默认 primary。",
    "source": "数据来源，默认 vision_service。",
    "event_type": "事件类型。跌倒确认事件使用 fall_confirmed。",
    "state": "对外事件状态。确认跌倒建议使用 confirmed_fall。",
    "status": "视觉内部状态。常见值 normal、falling、fallen_candidate、fallen_confirmed。",
    "service_state": "服务运行状态。常见值 running、degraded、unknown。",
    "severity": "告警等级。建议 L1/L2/L3，跌倒高风险用 L3。",
    "risk": "风险等级。常见值 low、medium、high、critical。",
    "risk_level": "同 risk，用于兼容主系统字段。",
    "fall_detected": "是否检测到跌倒确认事件。",
    "fall_prob": "跌倒概率，范围 0 到 1。",
    "fall_score": "跌倒评分，通常与 fall_prob 保持一致。",
    "track_id": "目标跟踪 ID，用于排查同一个人的连续事件。",
    "incident_id": "跌倒事件唯一 ID。主系统应使用它做弹窗去重。",
    "bbox": "人体框，格式为 [x1, y1, x2, y2]，单位为原始视频帧像素。",
    "snapshot_url": "Vision Service 暴露的跌倒截图 URL，主系统前端可直接展示。",
    "snapshot_path": "Vision Service 本机保存的截图路径，仅用于服务侧排查。",
    "timestamp": "事件或帧时间，ISO 8601 字符串。",
    "frame_seq": "帧序号。",
    "frame_width": "视频帧宽度。",
    "frame_height": "视频帧高度。",
    "scores": "多模型评分集合。",
    "injury": "伤害风险解释和处置建议。",
    "metadata": "调试、模型证据、融合证据和事件复用信息。"
  },
  "payload_templates": {
    "fall_event_push_to_main_system": {
      "required_fields": [
        "camera_id",
        "source",
        "event_type",
        "status",
        "severity",
        "risk_level",
        "fall_detected",
        "fall_prob",
        "track_id",
        "incident_id",
        "bbox",
        "timestamp"
      ],
