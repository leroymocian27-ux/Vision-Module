ALERT_OUTBOX_ENABLED=true
ALERT_OUTBOX_PATH=data/alert_outbox.sqlite3
ALERT_OUTBOX_RETRY_LIMIT=4

# Event semantic pipeline. All capabilities remain disabled until the event
# lifecycle and evidence flow are explicitly enabled for a deployment.
EVENT_PIPELINE_ENABLED=false
EVENT_RING_BUFFER_ENABLED=false
EVENT_WORKER_ENABLED=false
EVENT_SEMANTIC_ENABLED=false
EVENT_VLM_ENABLED=false
# VLM is advisory only. With EVENT_VLM_ENABLED=false no provider is created and
# no network request is made. Local Ollama remains an explicit opt-in experiment.
EVENT_VLM_PROVIDER=dummy
EVENT_VLM_ENDPOINT=
EVENT_VLM_TIMEOUT_SECONDS=8
EVENT_VLM_MAX_KEYFRAMES=6
EVENT_VLM_INCLUDE_TIMELINE_IMAGE=true
EVENT_VLM_PROMPT_VERSION=fall_event_review_v1
EVENT_VLM_OUTPUT_SCHEMA_VERSION=vlm_review_result_v1
EVENT_VLM_MAX_IMAGE_BYTES=5242880
EVENT_VLM_FAIL_OPEN=true
EVENT_VLM_HTTP_HEADERS_JSON=
EVENT_VLM_REQUEST_MODE=json
EVENT_VLM_PROVIDER_NAME=qwen
# Local Ollama text-only advisory experiment. Disabled unless EVENT_VLM_ENABLED=true
# and EVENT_VLM_PROVIDER is explicitly set to ollama or qwen_ollama.
EVENT_VLM_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/chat
EVENT_VLM_OLLAMA_MODEL=qwen3.5:4b
EVENT_VLM_OLLAMA_FALLBACK_MODEL=qwen3.5:4b
EVENT_VLM_OLLAMA_TIMEOUT_SECONDS=15
EVENT_VLM_OLLAMA_TEXT_ONLY=true
EVENT_VLM_OLLAMA_INCLUDE_IMAGES=false
# Local-only multimodal keyframe advisory. This is independent of the legacy
# text VLM and remains disabled until local media processing is approved.
EVENT_QWEN_KEYFRAME_ANALYSIS_ENABLED=false
EVENT_QWEN_KEYFRAME_ANALYZE_CANDIDATES=false
EVENT_QWEN_KEYFRAME_ENDPOINT=http://127.0.0.1:11434/api/chat
