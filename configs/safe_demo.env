GO2_READ_ONLY_ENABLED=false
GO2_CONTROL_ENABLED=false
GO2_LOW_LEVEL_CONTROL_ENABLED=false
GO2_CONTROL_APPROVED=false

STREAM_STALE_THRESHOLD_MS=3000
STREAM_STALE_RECONNECT_AFTER_MS=6000
MJPEG_CONNECT_TIMEOUT_SEC=3
MJPEG_READ_TIMEOUT_SEC=10
MJPEG_RECONNECT_INITIAL_SEC=0.5
MJPEG_RECONNECT_MAX_SEC=5
